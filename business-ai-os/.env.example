# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/businessaios

# ─── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here

# ─── LLM (OpenRouter) ────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=anthropic/claude-3-haiku

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Domain brainlo.ai must be verified in Resend dashboard
# DNS required: DKIM on resend._domainkey.brainlo.ai + SPF v=spf1 include:_spf.resend.com ~all
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=noreply@brainlo.ai

# ─── Stripe ──────────────────────────────────────────────────────────────────
# Use sk_test_xxx for development, sk_live_xxx for production
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_ID_SOLO_PRO=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/xxx

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ─── Python Microservice ─────────────────────────────────────────────────────
# Single canonical variable — used by all API routes
PYTHON_AGENT_URL=http://localhost:8000

# ─── Wiki / Knowledge Base ───────────────────────────────────────────────────
# Absolute path to wiki-data folder (user wikis stored here)
WIKI_BASE_PATH=/absolute/path/to/business-ai-os/wiki-data

# ─── Cron Jobs ───────────────────────────────────────────────────────────────
# Secret token to authorize cron endpoint calls (header: Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=your-cron-secret-min-32-chars

# ─── Integrations ────────────────────────────────────────────────────────────
# Notion integration (optional — for wiki sync)
NOTION_TOKEN=secret_xxx

# ─── Development / Debug ─────────────────────────────────────────────────────
# Set to 'true' to disable rate limiting in development
DISABLE_RATE_LIMIT=false
